          cat > lib/screens/change_pin.dart << 'EOF'
          import 'package:flutter/material.dart'; import 'package:cloud_firestore/cloud_firestore.dart';
          class ChangePinScreen extends StatefulWidget { const ChangePinScreen({super.key}); @override State<ChangePinScreen> createState() => _ChangePinScreenState(); }
          class _ChangePinScreenState extends State<ChangePinScreen> {
            final _currentCtrl = TextEditingController(); final _newCtrl = TextEditingController(); final _confirmCtrl = TextEditingController(); bool _loading = false;
            void _save() async {
              if (_currentCtrl.text.isEmpty || _newCtrl.text.isEmpty || _confirmCtrl.text.isEmpty) return;
              if (_newCtrl.text != _confirmCtrl.text) { ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('New PINs do not match!'))); return; }
              setState(() => _loading = true);
              try {
                final doc = await FirebaseFirestore.instance.collection('settings').doc('admin').get();
                String currentPin = doc.exists ? (doc.data()?['pin'] ?? '1234') : '1234';
                if (_currentCtrl.text != currentPin) throw 'Current PIN is incorrect!';
                await FirebaseFirestore.instance.collection('settings').doc('admin').set({'pin': _newCtrl.text.trim()}, SetOptions(merge: true));
                if (mounted) { ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Admin PIN Changed Successfully!'), backgroundColor: Colors.green)); Navigator.pop(context); }
              } catch (e) { if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(e.toString()))); } finally { if (mounted) setState(() => _loading = false); }
            }
            @override Widget build(BuildContext context) => Scaffold(appBar: AppBar(title: const Text('Change Admin PIN')), body: Padding(padding: const EdgeInsets.all(24), child: Column(children: [
              const Text('Update your Super Admin security PIN here.', style: TextStyle(color: Colors.grey)), const SizedBox(height: 24),
              TextField(controller: _currentCtrl, obscureText: true, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Current PIN', filled: true, fillColor: Color(0xFF131A26))), const SizedBox(height: 16),
              TextField(controller: _newCtrl, obscureText: true, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'New PIN', filled: true, fillColor: Color(0xFF131A26))), const SizedBox(height: 16),
              TextField(controller: _confirmCtrl, obscureText: true, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Confirm New PIN', filled: true, fillColor: Color(0xFF131A26))), const SizedBox(height: 32),
              SizedBox(width: double.infinity, height: 50, child: ElevatedButton(onPressed: _loading ? null : _save, child: _loading ? const CircularProgressIndicator() : const Text('UPDATE PIN'))),
            ])));
          }
          EOF

      - name: Decode Google Services (Admin)
        run: echo "${{ secrets.GOOGLE_SERVICES_JSON }}" | tr -d '[:space:]' | base64 -d > admin_app/android/app/google-services.json

      - name: Build Admin
        run: |
          cd admin_app
          flutter clean
          rm -rf ~/.gradle/caches/transforms-*
          rm -f pubspec.lock
          flutter pub get
          flutter build apk --release --no-tree-shake-icons

      - name: Release Admin
        uses: softprops/action-gh-release@v2
        with:
          tag_name: staff-v1.0.${{ github.run_number }}
          files: admin_app/build/app/outputs/flutter-apk/app-release.apk
