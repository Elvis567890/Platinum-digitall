          IMG_PATH=$(find . -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) ! -name "logo.png" | head -n 1)
          if [ -z "$IMG_PATH" ]; then echo "Error: No logo found!"; exit 1; fi
          sudo apt-get update && sudo apt-get install -y imagemagick-6.q16
          mkdir -p student_app/assets student_app/android/app/src/main/res/mipmap-xxxhdpi
          mkdir -p admin_app/assets admin_app/android/app/src/main/res/mipmap-xxxhdpi
          convert "$IMG_PATH" -resize 512x512 student_app/assets/logo.png
          convert "$IMG_PATH" -resize 512x512 student_app/android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png
          convert "$IMG_PATH" -resize 380x380 admin_app/assets/logo.png
