          import 'dart:io'; import 'package:http/http.dart' as http; import 'dart:convert'; import 'package:cloud_firestore/cloud_firestore.dart';
          class TelegramService {
            static String? _cachedToken; static String? _cachedChatId;
            static Future<void> _loadCredentials() async { if (_cachedToken != null && _cachedChatId != null) return; final doc = await FirebaseFirestore.instance.collection('settings').doc('telegram').get(); if (doc.exists) { _cachedToken = doc.data()?['token']; _cachedChatId = doc.data()?['chat_id']; } }
            static Future<String?> uploadFile(File file, String type) async {
              await _loadCredentials(); if (_cachedToken == null || _cachedChatId == null) throw 'Telegram settings missing.';
              String endpoint = 'sendDocument'; String fileField = 'document'; if (type == 'image') { endpoint = 'sendPhoto'; fileField = 'photo'; } else if (type == 'video') { endpoint = 'sendVideo'; fileField = 'video'; } else if (type == 'audio') { endpoint = 'sendAudio'; fileField = 'audio'; }
              var request = http.MultipartRequest('POST', Uri.parse('https://api.telegram.org/bot$_cachedToken/$endpoint')); request.fields['chat_id'] = _cachedChatId!; request.files.add(await http.MultipartFile.fromPath(fileField, file.path));
              var response = await request.send(); var responseData = await response.stream.bytesToString(); var jsonResponse = jsonDecode(responseData);
              if (jsonResponse['ok'] == true) { var result = jsonResponse['result']; if (type == 'image') return result['photo'].last['file_id']; if (type == 'video') return result['video']['file_id']; if (type == 'audio') return result['audio']['file_id']; return result['document']['file_id']; } else { throw jsonResponse['description'] ?? 'Upload failed'; }
            }
